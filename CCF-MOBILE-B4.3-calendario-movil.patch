*** BEGIN PATCH: CCF-MOBILE-B4.3 — CALENDARIO MÓVIL — Backup-1.6-adaptación-móvil

OBJETIVO
- Adaptar visualmente el calendario existente a móvil.
- No modificar B232.26.4-calendario-safe.js.
- No modificar index.html.
- No cambiar la versión B4.3.0.
- No crear consultas Supabase ni cálculos financieros nuevos.
- El módulo B232.26.4 sigue siendo la única fuente funcional.
- La capa móvil solo replica la información ya renderizada por el calendario nativo.

1) CCF-MOBILE-B4.3.js

A. Inmediatamente antes de:
   function navigate(id){

   insertar:

/* CALENDARIO MÓVIL — adaptación progresiva sobre DOM nativo */
let calendarMobileObserver=null;
let calendarMobileTimer=0;
let calendarMobileRendering=false;

function stopCalendarMobile(){
  if(calendarMobileObserver){
    calendarMobileObserver.disconnect();
    calendarMobileObserver=null;
  }
  clearTimeout(calendarMobileTimer);
  calendarMobileTimer=0;
  calendarMobileRendering=false;
}

function scheduleCalendarMobile(){
  clearTimeout(calendarMobileTimer);
  calendarMobileTimer=setTimeout(buildCalendarMobile,40);
}

function buildCalendarMobile(){
  calendarMobileTimer=0;
  if(!mobile())return false;

  const section=by('calendario');
  if(!section||section.classList.contains('hidden'))return false;

  const nativeCard=section.querySelector('.b232261-card');
  const nativeScroll=nativeCard?.querySelector('.b232261-scroll');
  const nativeWeek=nativeScroll?.querySelector('.b232261-grid.b232261-week');

  if(!nativeCard||!nativeScroll||!nativeWeek)return false;

  const nativeDays=[...nativeWeek.querySelectorAll('.b232261-day')];
  if(nativeDays.length!==42)return false;

  calendarMobileRendering=true;

  try{
    let mobileCard=nativeCard.querySelector('[data-b434-calendar-mobile]');

    if(!mobileCard){
      mobileCard=document.createElement('section');
      mobileCard.className='b434-calendar-mobile';
      mobileCard.dataset.b434CalendarMobile='1';
      nativeScroll.before(mobileCard);
    }

    const title=
      nativeCard.querySelector('.b232261-head h2')
      ?.textContent?.trim()||
      'Calendario mensual';

    const scope=
      nativeCard.querySelector('.b232261-scope')
      ?.cloneNode(true);

    mobileCard.replaceChildren();

    const period=document.createElement('div');
    period.className='b434-calendar-mobile-period';
    period.innerHTML='<span>PERÍODO</span><strong></strong>';
    period.querySelector('strong').textContent=title;
    mobileCard.appendChild(period);

    const weekdays=document.createElement('div');
    weekdays.className='b434-calendar-mobile-week';

    [...nativeWeek.children].slice(0,7).forEach(cell=>{
      const item=document.createElement('div');
      item.textContent=cell.textContent.trim();
      weekdays.appendChild(item);
    });

    mobileCard.appendChild(weekdays);

    const grid=document.createElement('div');
    grid.className='b434-calendar-mobile-grid';

    nativeDays.forEach(original=>{
      const day=document.createElement('button');
      day.type='button';
      day.className='b434-calendar-mobile-day';

      if(original.classList.contains('out'))
        day.classList.add('is-out');

      if(original.classList.contains('selected'))
        day.classList.add('is-selected');

      const top=original.querySelector('.b232261-day-top');

      const topBox=document.createElement('div');
      topBox.className='b434-calendar-mobile-day-top';

      const number=document.createElement('strong');
      number.textContent=
        top?.querySelector('strong')?.textContent?.trim()||'';

      topBox.appendChild(number);

      const todayMark=
        top?.querySelector('small')?.textContent?.trim();

      if(todayMark){
        const badge=document.createElement('span');
        badge.textContent=todayMark;
        topBox.appendChild(badge);
      }

      day.appendChild(topBox);

      const events=document.createElement('div');
      events.className='b434-calendar-mobile-events';

      const nativeEvents=
        [...original.querySelectorAll('.b232261-event')];

      nativeEvents.slice(0,3).forEach(nativeEvent=>{
        const event=document.createElement('span');
        event.className='b434-calendar-mobile-event';

        if(nativeEvent.classList.contains('b232261-real-in'))
          event.classList.add('income');
        else if(nativeEvent.classList.contains('b232261-real-out'))
          event.classList.add('expense');
        else if(nativeEvent.classList.contains('b232261-plan-in'))
          event.classList.add('planned-income');
        else if(nativeEvent.classList.contains('b232261-plan-out'))
          event.classList.add('planned-expense');
        else if(nativeEvent.classList.contains('b232261-debt'))
          event.classList.add('obligation');
        else if(nativeEvent.classList.contains('b232261-gen'))
          event.classList.add('generation');

        event.textContent=nativeEvent.textContent.trim();
        events.appendChild(event);
      });

      if(nativeEvents.length>3){
        const more=document.createElement('span');
        more.className='b434-calendar-mobile-more';
        more.textContent='+'+(nativeEvents.length-3)+' más';
        events.appendChild(more);
      }

      day.appendChild(events);

      const minis=
        [...original.querySelectorAll('.b232261-mini')];

      if(minis.length){
        const metrics=document.createElement('div');
        metrics.className='b434-calendar-mobile-metrics';

        metrics.textContent=minis
          .slice(0,2)
          .map(x=>x.textContent.trim())
          .filter(Boolean)
          .join(' · ');

        day.appendChild(metrics);
      }

      day.onclick=event=>{
        event.preventDefault();
        event.stopPropagation();

        /* La acción real sigue perteneciendo al calendario nativo. */
        original.click();

        scheduleCalendarMobile();
      };

      grid.appendChild(day);
    });

    mobileCard.appendChild(grid);

    if(scope){
      scope.classList.add('b434-calendar-mobile-scope');
      mobileCard.appendChild(scope);
    }

    nativeScroll.hidden=true;
    nativeScroll.setAttribute('aria-hidden','true');

    return true;

  }finally{
    calendarMobileRendering=false;
  }
}

function startCalendarMobile(){
  stopCalendarMobile();

  if(!mobile())return;

  const section=by('calendario');
  if(!section)return;

  calendarMobileObserver=
    new MutationObserver(()=>{
      if(calendarMobileRendering)return;
      scheduleCalendarMobile();
    });

  calendarMobileObserver.observe(
    section,
    {childList:true,subtree:true}
  );

  buildCalendarMobile();

  [100,300,700,1200].forEach(ms=>{
    setTimeout(buildCalendarMobile,ms);
  });
}

B. Dentro de restoreActiveModule(), al comienzo de la función, insertar:

   stopCalendarMobile();

C. Dentro de showModuleAfterNavigation(id), después de:
   if(ok){

   insertar:

   if(id==='calendario'){
     startCalendarMobile();
   }

