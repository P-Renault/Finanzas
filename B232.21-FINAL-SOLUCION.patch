*** B232.21 — SOLUCIÓN FINAL: ARRANQUE + NAVEGACIÓN ***

OBJETIVO
- Evitar que un fallo de Supabase deje bloqueada la interfaz en "Conectar".
- Unificar la navegación de botones estáticos y dinámicos.
- Integrar Operaciones, Planificación, Motor Multifuente y Control de Jornada.
- Mantener B232 como propietario del Calendario.
- Eliminar runtimes de navegación superpuestos.

1) app.js
REEMPLAZAR COMPLETAMENTE el bloque `async function connect(){...}` por:

async function connect(){
  const url=$('supabaseUrl').value.trim();
  const key=$('supabaseKey').value.trim();

  if(!url||!key){
    return msg('configMsg','Completa ambos campos.');
  }

  const btn=$('saveConfig');
  if(btn){ btn.disabled=true; btn.textContent='Conectando...'; }

  try{
    if(!window.supabase||typeof window.supabase.createClient!=='function'){
      throw new Error('La biblioteca de Supabase no está disponible.');
    }

    db=window.supabase.createClient(url,key,{
      auth:{persistSession:false,autoRefreshToken:false}
    });

    localStorage.setItem('sf_url',url);
    localStorage.setItem('sf_key',key);

    $('configPanel').classList.add('hidden');
    $('app').classList.remove('hidden');
    $('logoutBtn').classList.remove('hidden');

    const notice=document.getElementById('appStatus');
    if(notice) notice.textContent='Verificando conexión con Supabase...';

    const probe=await db.from('movimientos').select('id').limit(1);

    if(probe.error){
      console.error('Supabase probe:',probe.error);
      if(notice){
        notice.textContent='Interfaz cargada. Supabase respondió con error: '+probe.error.message;
      }
      return;
    }

    if(notice) notice.textContent='Supabase conectado correctamente.';
    await refresh();

  }catch(e){
    console.error('[FINANZAS] Error de conexión:',e);

    $('configPanel').classList.add('hidden');
    $('app').classList.remove('hidden');
    $('logoutBtn').classList.remove('hidden');

    const notice=document.getElementById('appStatus');
    if(notice){
      notice.textContent='Error de conexión: '+(e.message||e);
    }

  }finally{
    if(btn){
      btn.disabled=false;
      btn.textContent='Conectar';
    }
  }
}

REEMPLAZAR el bloque antiguo `TABS` de app.js por:

/* ============================================================
   B232.21 · NAVEGACIÓN UNIFICADA
   ============================================================ */

function navigateTab(id){
  const section=$(id);

  if(!section){
    console.warn('[B232.21] Sección no disponible:',id);
    return false;
  }

  document.querySelectorAll('.tab').forEach(x=>{
    x.classList.toggle('hidden',x.id!==id);
  });

  document.querySelectorAll('.tabs button[data-tab]').forEach(x=>{
    x.classList.toggle('active',x.dataset.tab===id);
  });

  localStorage.setItem('cf_active_tab_v2',id);

  try{
    if(
      (id==='operaciones' ||
       id==='ingresos' ||
       id==='jornadas') &&
      typeof window.b219Show==='function'
    ){
      window.b219Show(id);
    }

    if(
      id==='planificacion' &&
      typeof window.fin216Plan==='function'
    ){
      window.fin216Plan();
    }

    if(
      id==='calendario' &&
      window.B232Calendario &&
      typeof window.B232Calendario.load==='function'
    ){
      setTimeout(()=>{
        window.B232Calendario.load().catch(console.error);
      },0);
    }

  }catch(error){
    console.error(
      '[B232.21] Error cargando módulo '+id,
      error
    );
  }

  return true;
}

document.addEventListener('click',event=>{
  const button=event.target.closest(
    '.tabs button[data-tab]'
  );

  if(!button)return;

  event.preventDefault();
  event.stopPropagation();

  if(typeof event.stopImmediatePropagation==='function'){
    event.stopImmediatePropagation();
  }

  navigateTab(button.dataset.tab);

},true);

window.B23221Navigation={
  version:'232.21',
  navigate:navigateTab
};

